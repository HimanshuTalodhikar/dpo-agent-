# ── Environment Configuration ──────────────────────────────────────────────────
# Copy this to .env for local development
# In production, set these via AWS Secrets Manager / ECS Task Definition env vars

# ── Application ─��──────────────────────────────────────────────────────────────
ENVIRONMENT=local                       # local | production
LOG_LEVEL=DEBUG                         # DEBUG | INFO | WARNING | ERROR
USE_MOCK_LLM=true                       # true = use mock LLM server (no AWS creds needed)
USE_MOCK_STORAGE=false                  # true = use local filesystem instead of S3

# ── Mock LLM Server (local dev) ─────��─────────────────────────────────────────
MOCK_LLM_URL=http://localhost:8080/v1/chat/completions

# ── Database (Aurora PostgreSQL + pgvector) ───────────────────────────────────
# Local: postgresql+asyncpg://user:pass@localhost:5433/dbname
# Production: retrieved from Secrets Manager
DATABASE_URL=postgresql+asyncpg://cloagent:cloagent_secret@localhost:5433/cloagent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Amazon Bedrock ─────────────────────────────────────────────────────────────
# Used when USE_MOCK_LLM=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v1
BEDROCK_REGION=us-east-1
BEDROCK_ENDPOINT_URL=                    # Optional: override Bedrock endpoint (e.g., for VPC PrivateLink)

# ── Amazon Titan Embeddings ────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REGION=us-east-1

# ── Amazon S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=                        # Leave empty to use IAM role (ECS) or environment vars
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cloagent-documents
S3_ENDPOINT_URL=                          # Optional: http://localhost:4566 for LocalStack
S3_REGION=us-east-1

# ── Amazon Secrets Manager ──────────────────────────────────────────────────────
# ARN of the secret containing DB credentials: {"username": "...", "password": "..."}
SECRET_MANAGER_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:cloagent/db-credentials-XXXXX

# ── AWS KMS ──��─────────────────────────────────────────────────────────────────
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Security ───────────────────────────────────────────────────────────────────
ENCRYPTION_ENABLED=true
AUDIT_ENABLED=true

# ── Ingestion ─────────────────────────────────────────────────────────────────
INGEST_SAMPLE_DOCS=false                  # true = seed sample_docs/ on app startup
MAX_CHUNK_SIZE=512                        # tokens
CHUNK_OVERLAP=64                          # tokens

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10                        # number of chunks to retrieve
RERANK_ENABLED=false                       # enable semantic reranking
RERANK_TOP_N=5                            # chunks after reranking

# ���─ MCP Server ─────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000


# ── Codemax LLM (Anthropic via proxy) ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.codemax.pro
ANTHROPIC_MODEL=claude-sonnet-5

# ── Graphiti + Amazon Neptune (Knowledge Graph) ─────────────────────────────────
# Neptune connection: neptune-db://<cluster-endpoint>:<port>
# Or for Neptune Analytics: neptune-graph://<graph-id>
GRAPHITI_NEPTUNE_HOST=neptune-db://your-neptune-cluster.region.neptune.amazonaws.com:8182
# OpenSearch Serverless collection host (required for vector search)
GRAPHITI_AOSS_HOST=your-search-collection.region.aoss.amazonaws.com
GRAPHITI_AOSS_PORT=443
GRAPHITI_AWS_REGION=us-east-1
GRAPHITI_GRAPH_NAME=govt-knowledge-base
GRAPHITI_ANTHROPIC_API_KEY=your_anthropic_api_key_here
GRAPHITI_ANTHROPIC_BASE_URL=https://api.codemax.pro
GRAPHITI_ANTHROPIC_MODEL=claude-sonnet-5
# Embeddings inside Graphiti (OpenAI)
GRAPHITI_OPENAI_API_KEY=
